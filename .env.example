# Copia questo file in .env (mai committato: è nel .gitignore).
# In CI/CD gli stessi valori stanno nei GitHub Secrets, mai nel codice.

# --- Back end (proxy) -------------------------------------------------------
# Chiave della NYT API (https://developer.nytimes.com/get-started).
# Resta sul server (Vite dev, container "api", Netlify Function): non arriva
# mai al browser perché non ha il prefisso VITE_.
NYT_API_KEY=

# --- Front end (letto da Vite al momento della build) -----------------------
# DSN del progetto Sentry. Vuoto = error tracking spento.
VITE_SENTRY_DSN=
