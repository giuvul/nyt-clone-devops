{
  "name": "nyt-clone-devops",
  "version": "1.0.0",
  "description": "Clone della home del New York Times (React) con ciclo DevOps completo: Docker, GitHub Actions, Netlify, Sentry, UptimeRobot.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "start:api": "node --env-file-if-exists=.env server/index.js",
    "docker:up": "docker compose up --build -d --wait",
    "docker:down": "docker compose down"
  },
  "author": "Giuseppe Vulduraro",
  "license": "MIT",
  "dependencies": {
    "@fontsource-variable/libre-franklin": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@sentry/react": "^11.12.0",
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^29.1.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "engines": {
    "node": ">=22.12"
  }
}
